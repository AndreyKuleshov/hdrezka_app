<?xml version="1.0" encoding="utf-8"?>
<!-- Подсказка об управлении при первом запуске: о долгом OK и перемотке узнать больше неоткуда.
     Гасится любой кнопкой пульта и больше не показывается -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hintOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_screen"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hint_title"
        android:textColor="@color/accent"
        android:textSize="@dimen/text_display"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:lineSpacingExtra="10dp"
        android:text="@string/hint_body"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/hint_dismiss"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_label" />
</LinearLayout>
