<?xml version="1.0" encoding="utf-8"?>
<!-- Баннер 320x180 для лаунчера Android TV -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#1B1B1F" android:endColor="#FF6A00" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="120dp" android:height="120dp"
        android:drawable="@drawable/ic_play" />
</layer-list>
